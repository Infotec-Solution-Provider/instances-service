INSTANCES_DATABASE_URL=="mysql://<user>:<password>@<host>:<port>/<database>?schema=public"
LISTEN_PORT=8000
WHITELIST_IPS=1.1.1.1,1.1.1.2

# Recuperacao opcional do ZeroTier instalado no mesmo host (Linux/systemd ou Windows).
# Habilite em apenas um processo por host, apos configurar as permissoes do README.
ZEROTIER_RECOVERY_ENABLED=false
ZEROTIER_RECOVERY_INTERVAL_MS=30000
ZEROTIER_RECOVERY_FAILURE_THRESHOLD=3
ZEROTIER_RECOVERY_COOLDOWN_MS=600000
ZEROTIER_RECOVERY_STARTUP_GRACE_MS=60000
ZEROTIER_RECOVERY_COMMAND_TIMEOUT_MS=15000
ZEROTIER_RECOVERY_RESTART_TIMEOUT_MS=30000
# Opcional: IDs de rede com 16 caracteres hexadecimais, separados por virgula.
ZEROTIER_RECOVERY_NETWORK_IDS=
# Opcional: host:porta por virgula, com ao menos 2 hosts distintos via ZeroTier.
# Todos precisam falhar para sinalizar perda de trafego; timeout TCP de 5 segundos.
# ZEROTIER_RECOVERY_PROBE_TARGETS=10.147.17.10:3306,10.147.17.20:443
ZEROTIER_RECOVERY_PROBE_TARGETS=
# Caminho absoluto do executavel, sem argumentos; vazio usa o padrao da plataforma.
# Linux: /usr/sbin/zerotier-cli
# Windows: C:\Program Files (x86)\ZeroTier\One\zerotier-one_x64.exe
ZEROTIER_CLI_PATH=
# Linux: executa somente os comandos documentados via sudo -n (sem prompt).
ZEROTIER_RECOVERY_USE_SUDO=true
